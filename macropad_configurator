    def build_encoder_summary_card(self, parent, enc_idx, row, column):
        """Tarjeta angosta que muestra un resumen del encoder y abre un popup para configurarlo."""
        card = ctk.CTkFrame(parent, fg_color="#1a1a2e", border_width=1, border_color="#3b3b5c")
        card.grid(row=row, column=column, padx=8, pady=6, sticky="n")

        ctk.CTkLabel(card, text=f"🎚️ Encoder {enc_idx+1}", font=("Arial", 11, "bold")).pack(pady=(8, 4), padx=8)

        summary_lbl = ctk.CTkLabel(card, text="---", font=("Arial", 9), text_color="gray", justify="left")
        summary_lbl.pack(pady=(0, 6), padx=8)

        open_btn = ctk.CTkButton(
            card, text="⚙️ Configurar", width=100, height=28,
            fg_color="#1f538d",
            command=lambda e=enc_idx: self.open_encoder_popup(e)
        )
        open_btn.pack(pady=(0, 8), padx=8)

        self.encoder_cards[enc_idx] = {"summary_lbl": summary_lbl}

    def update_encoder_summary(self, enc_idx):
        """Refresca el texto resumen (CCW/CW/Push) de la tarjeta compacta de un encoder."""
        if enc_idx not in self.encoder_cards:
            return
        layer = self.config_data["layers"][self.active_layer_index]
        enc_cfg = layer["encoders"][enc_idx]
        summary_text = f"⟲ {enc_cfg['ccw']}\n⟳ {enc_cfg['cw']}\n🔘 {enc_cfg['push']}"
        self.encoder_cards[enc_idx]["summary_lbl"].configure(text=summary_text)

    def open_encoder_popup(self, enc_idx):
        """Abre una ventana emergente para configurar un encoder: el Push arriba, y CCW/CW
        a cada lado de un ícono del encoder que representa hacia dónde gira cada uno."""
        # Si ya está abierto, solo la trae al frente en vez de duplicarla
        existing = self.encoder_popup_windows.get(enc_idx)
        if existing is not None and existing.winfo_exists():
            existing.lift()
            existing.focus()
            return

        popup = ctk.CTkToplevel(self)
        popup.title(f"Encoder {enc_idx+1} - Configuración")
        popup.geometry("420x320")
        popup.resizable(False, False)
        popup.transient(self)
        popup.grab_set()  # modal, evita editar la capa mientras el popup está abierto

        ctk.CTkLabel(popup, text=f"🎚️ Encoder {enc_idx+1}", font=("Arial", 14, "bold")).pack(pady=(15, 10))

        widgets = {}

        def build_action_column(parent, action_key, label_text):
            col_frame = ctk.CTkFrame(parent, fg_color="transparent")
            ctk.CTkLabel(col_frame, text=label_text, font=("Arial", 10)).pack(pady=(0, 6))

            current_val = self.get_target_value(("enc", enc_idx, action_key))
            btn = ctk.CTkButton(
                col_frame, text=current_val, width=120, height=35,
                fg_color="#2b2b2b", hover_color="#3b3b3b",
                command=lambda e=enc_idx, a=action_key: self.start_capturing(("enc", e, a))
            )
            btn.pack(pady=3)

            combo = ctk.CTkOptionMenu(
                col_frame, values=["Especial..."] + PRESET_SPECIAL_KEYS,
                width=120, height=24, font=("Arial", 10),
                command=lambda val, e=enc_idx, a=action_key: self.assign_preset(("enc", e, a), val)
            )
            combo.set("Especial...")
            combo.pack(pady=3)

            widgets[f"{action_key}_btn"] = btn
            widgets[f"{action_key}_dd"] = combo
            return col_frame

        # --- ARRIBA: el botón pulsador (Push) ---
        push_col = build_action_column(popup, "push", "🔘 Push")
        push_col.pack(pady=(0, 15))

        # --- MEDIO: CCW (izq) - ícono del encoder - CW (der) ---
        middle_frame = ctk.CTkFrame(popup, fg_color="transparent")
        middle_frame.pack(pady=5)
        middle_frame.grid_columnconfigure(0, weight=1)
        middle_frame.grid_columnconfigure(1, weight=0)
        middle_frame.grid_columnconfigure(2, weight=1)

        ccw_col = build_action_column(middle_frame, "ccw", "⟲ Izq (CCW)")
        ccw_col.grid(row=0, column=0, padx=12, sticky="n")

        self.draw_encoder_icon(middle_frame).grid(row=0, column=1, padx=10, sticky="n")

        cw_col = build_action_column(middle_frame, "cw", "⟳ Der (CW)")
        cw_col.grid(row=0, column=2, padx=12, sticky="n")

        self.encoder_popup_widgets[enc_idx] = widgets
        self.encoder_popup_windows[enc_idx] = popup

        def on_close():
            self.capturing_target = None
            self.encoder_popup_widgets.pop(enc_idx, None)
            self.encoder_popup_windows.pop(enc_idx, None)
            self.update_encoder_summary(enc_idx)
            popup.grab_release()
            popup.destroy()

        close_btn = ctk.CTkButton(popup, text="Cerrar", command=on_close, fg_color="#1f538d")
        close_btn.pack(pady=15)

        popup.protocol("WM_DELETE_WINDOW", on_close)

    def draw_encoder_icon(self, parent):
        """Dibuja un pequeño ícono del encoder EC11 (perilla + flechas de giro) para mostrar
        en el medio del popup, entre las opciones de CCW y CW."""
        size = 84
        canvas = ctk.CTkCanvas(parent, width=size, height=size, bg="#1a1a2e", highlightthickness=0)

        cx, cy = size / 2, size / 2

        # Flecha de giro hacia la izquierda (CCW)
        canvas.create_arc(6, 6, size - 6, size - 6, start=110, extent=90,
                           style="arc", outline="#5dade2", width=3)
        canvas.create_line(10, 30, 6, 22, 16, 20, fill="#5dade2", width=3,
                            capstyle="round", joinstyle="round")

        # Flecha de giro hacia la derecha (CW)
        canvas.create_arc(6, 6, size - 6, size - 6, start=-20, extent=90,
                           style="arc", outline="#5dade2", width=3)
        canvas.create_line(size - 10, 30, size - 6, 22, size - 16, 20, fill="#5dade2", width=3,
                            capstyle="round", joinstyle="round")

        # Cuerpo de la perilla (knob) del encoder
        knob_r = size * 0.28
        canvas.create_oval(cx - knob_r - 3, cy - knob_r - 3 + 6, cx + knob_r + 3, cy + knob_r + 3 + 6,
                            fill="#2b2b2b", outline="#555555", width=2)
        canvas.create_oval(cx - knob_r, cy - knob_r + 6, cx + knob_r, cy + knob_r + 6,
                            fill="#3b3b3b", outline="#666666")
        # Marca indicadora de posición, apuntando hacia arriba
        canvas.create_line(cx, cy + 6, cx, cy - knob_r + 4 + 6, fill="white", width=3, capstyle="round")

        # Eje/vástago hacia abajo (representa el botón pulsador)
        canvas.create_rectangle(cx - 3, cy + knob_r + 3, cx + 3, cy + knob_r + 14,
                                 fill="#555555", outline="")

        return canvas



    def close_all_encoder_popups(self):
        """Cierra cualquier popup de encoder abierto, por ejemplo al cambiar de capa."""
        for enc_idx, popup in list(self.encoder_popup_windows.items()):
            try:
                if popup.winfo_exists():
                    popup.grab_release()
                    popup.destroy()
            except Exception:
                pass
        self.encoder_popup_widgets.clear()
        self.encoder_popup_windows.clear()

    # ------------------------------------------------------------------
    # Captura de teclas (generalizada para botones Y encoders)
    # ------------------------------------------------------------------
    def start_capturing(self, target):
        """Prepara el widget objetivo y lanza el hilo de captura segura (anti-bloqueos)."""
        self.capturing_target = target

        # Resetear estilo de todos los widgets capturables, y resaltar el activo
        for i in range(9):
            if target == ("btn", i):
                self.grid_buttons[i].configure(text="⌨️ Escuchando...", fg_color="darkorange", hover_color="orange")
            else:
                self.restore_widget_style(("btn", i))

        for e_idx, widgets in self.encoder_popup_widgets.items():
            for action in ("ccw", "cw", "push"):
                t = ("enc", e_idx, action)
                if target == t:
                    widgets[f"{action}_btn"].configure(text="⌨️ Escuchando...", fg_color="darkorange", hover_color="orange")
                else:
                    self.restore_widget_style(t)

        # Ejecutar lectura de teclado en un hilo secundario para no congelar la UI visual de Tkinter
        threading.Thread(target=self._capture_thread, args=(target,), daemon=True).start()

    def _capture_thread(self, target):
        """Captura global que desactiva el paso del atajo al resto de programas."""
        try:
            # 1. Forzar limpieza de la memoria interna antes de leer
            # (evita que se sumen modificadores de pulsaciones anteriores)
            keyboard._pressed_events.clear()

            # suppress=True evita que se abran otros programas al configurar
            raw_shortcut = keyboard.read_hotkey(suppress=True)

            # 2. Forzar limpieza después de capturar para soltar virtualmente las teclas
            keyboard._pressed_events.clear()

            # 3. Si por rebote capta secuencias separadas por coma (ej: "ctrl+c, ctrl+c"),
            # nos quedamos solo con la primera instrucción limpia.
            raw_shortcut = raw_shortcut.split(',')[0].strip()

            # Volvemos al hilo principal de Tkinter para aplicar los cambios visuales
            self.after(0, lambda: self._apply_captured_key(target, raw_shortcut))
        except Exception as e:
            print(f"Error al capturar la tecla: {e}")
            self.after(0, lambda: self.restore_widget_style(target))

    def _format_shortcut(self, raw_shortcut):
        """Traduce el formato interno de keyboard a la sintaxis limpia de Keycode."""
        parts = raw_shortcut.split('+')
        formatted_parts = []

        # Diccionario para mapear las teclas al formato de CircuitPython
        KEY_MAP = {
            "enter": "ENTER",
            "esc": "ESC",
            "backspace": "BACKSPACE",
            "tab": "TAB",
            "space": "SPACE",
            "delete": "DEL",
            "up": "UP_ARROW",
            "down": "DOWN_ARROW",
            "left": "LEFT_ARROW",
            "right": "RIGHT_ARROW",
            "print screen": "PRINTSCREEN",
            "windows": "Win",
            "ctrl": "Ctrl",
            "shift": "Shift",
            "alt": "Alt",
            "alt gr": "Alt"
        }

        for part in parts:
            p = part.strip().lower()
            if p in KEY_MAP:
                formatted_parts.append(KEY_MAP[p])
            else:
                formatted_parts.append(p.upper())

        return "+".join(formatted_parts)

    def _apply_captured_key(self, target, raw_shortcut):
        """Impacta los cambios de la tecla generada dentro de la configuración visual."""
        # Evita una sobrescritura si el usuario cambió de capa/target antes de presionar una tecla
        if self.capturing_target != target:
            return

        clean_shortcut = self._format_shortcut(raw_shortcut)
        self.set_target_value(target, clean_shortcut)
        self.capturing_target = None
        self.restore_widget_style(target)
        if target[0] == "enc":
            self.update_encoder_summary(target[1])

    # ------------------------------------------------------------------
    # Helpers genéricos target <-> config_data / widgets
    # ------------------------------------------------------------------
    def get_target_value(self, target):
        layer = self.config_data["layers"][self.active_layer_index]
        if target[0] == "btn":
            _, idx = target
            return layer["keys"][idx]
        else:
            _, enc_idx, action = target
            return layer["encoders"][enc_idx][action]

    def set_target_value(self, target, value):
        layer = self.config_data["layers"][self.active_layer_index]
        if target[0] == "btn":
            _, idx = target
            layer["keys"][idx] = value
        else:
            _, enc_idx, action = target
            layer["encoders"][enc_idx][action] = value

    def get_target_button_widget(self, target):
        if target[0] == "btn":
            return self.grid_buttons[target[1]]
        else:
            _, enc_idx, action = target
            widgets = self.encoder_popup_widgets.get(enc_idx)
            if widgets is None:
                return None
            return widgets.get(f"{action}_btn")

    def get_target_dropdown_widget(self, target):
        if target[0] == "btn":
            return self.grid_dropdowns[target[1]]
        else:
            _, enc_idx, action = target
            widgets = self.encoder_popup_widgets.get(enc_idx)
            if widgets is None:
                return None
            return widgets.get(f"{action}_dd")

    def restore_widget_style(self, target):
        widget = self.get_target_button_widget(target)
        if widget is None or not widget.winfo_exists():
            return  # el popup del encoder está cerrado; no hay nada que actualizar visualmente
        val = self.get_target_value(target)
        widget.configure(text=val, fg_color="#2b2b2b", hover_color="#3b3b3b")

    def assign_preset(self, target, selected_val):
        if selected_val.startswith("---") or selected_val == "Especial...":
            return
        self.set_target_value(target, selected_val)
        self.restore_widget_style(target)
        dropdown = self.get_target_dropdown_widget(target)
        if dropdown is not None and dropdown.winfo_exists():
            dropdown.set("Especial...")
        if target[0] == "enc":
            self.update_encoder_summary(target[1])

    # ------------------------------------------------------------------
    # Capas
    # ------------------------------------------------------------------
    def refresh_layers_list(self):
        for widget in self.layers_scroll.winfo_children():
            widget.destroy()

        for idx, layer in enumerate(self.config_data["layers"]):
            is_active = (idx == self.active_layer_index)
            btn_color = "#1f538d" if is_active else "#333333"

            icon_symbol = layer.get("icon", "MONITOR")
            btn = ctk.CTkButton(
                self.layers_scroll,
                text=f"#{idx} [{icon_symbol}] {layer['name']}",
                fg_color=btn_color,
                anchor="w",
                command=lambda i=idx: self.select_layer(i)
            )
            btn.pack(pady=4, fill="x")

        self.load_layer_into_editor(self.active_layer_index)

    def select_layer(self, index):
        self.active_layer_index = index
        self.capturing_target = None  # Resetea el tracker si se cambia de capa
        self.close_all_encoder_popups()  # evita editar el encoder de la capa anterior por error
        self.refresh_layers_list()

    def load_layer_into_editor(self, index):
        layer = self.config_data["layers"][index]
        self.layer_name_entry.delete(0, "end")
        self.layer_name_entry.insert(0, layer["name"])

        current_icon = layer.get("icon", "MONITOR")
        self.icon_menu.set(current_icon if current_icon in AVAILABLE_ICONS else "MONITOR")

        # El botón "Editar" ahora funciona para cualquier ícono: los personalizados abren
        # su bitmap guardado, y los íconos base se rasterizan como punto de partida editable.
        self.btn_edit_icon.configure(state="normal", fg_color="#555555")

        for i in range(9):
            val = layer["keys"][i] if i < len(layer["keys"]) else "F1"
            self.grid_buttons[i].configure(text=val, fg_color="#2b2b2b", hover_color="#3b3b3b")
            self.grid_dropdowns[i].set("Especial...")

        encoders = layer.get("encoders", default_encoders())
        for e_idx in range(NUM_ENCODERS):
            if e_idx >= len(encoders):
                layer.setdefault("encoders", []).append({"ccw": "F1", "cw": "F1", "push": "F1"})
            self.update_encoder_summary(e_idx)

        self.refresh_oled_preview()

    def update_active_layer_name(self, event=None):
        new_name = self.layer_name_entry.get().upper()
        self.config_data["layers"][self.active_layer_index]["name"] = new_name
        self.refresh_layers_list()

    def update_active_layer_icon(self, selected_icon):
        if selected_icon == NEW_ICON_SENTINEL:
            self.open_new_icon_popup()
            return
        self.config_data["layers"][self.active_layer_index]["icon"] = selected_icon
        self.refresh_layers_list()

    def open_new_icon_popup(self):
        """Popup para dar de alta un ícono nuevo: nombre + mini editor de píxeles 16x16."""
        popup = ctk.CTkToplevel(self)
        popup.title("Nuevo Ícono")
        popup.geometry("300x470")
        popup.resizable(False, False)
        popup.transient(self)
        popup.grab_set()

        ctk.CTkLabel(popup, text="➕ Nombre del nuevo ícono", font=("Arial", 13, "bold")).pack(pady=(15, 4))
        ctk.CTkLabel(popup, text="Solo letras, números y '_'", font=("Arial", 9), text_color="gray").pack(pady=(0, 6))

        entry = ctk.CTkEntry(popup, width=220, placeholder_text="Ej: WIFI, BATTERY, HEART")
        entry.pack(pady=(0, 10))
        entry.focus()

        ctk.CTkLabel(popup, text="🎨 Dibujá el ícono (16x16 px)", font=("Arial", 11, "bold")).pack(pady=(0, 2))
        ctk.CTkLabel(popup, text="Click para pintar/borrar, arrastrá para dibujar varios", font=("Arial", 8), text_color="gray").pack(pady=(0, 6))

        # --- Mini editor de píxeles ---
        grid_size = 16
        cell_px = 11
        canvas_size = grid_size * cell_px

        editor_canvas = ctk.CTkCanvas(
            popup, width=canvas_size, height=canvas_size,
            bg="black", highlightthickness=1, highlightbackground="#333333"
        )
        editor_canvas.pack(pady=(0, 8))

        icon_grid = [[0] * grid_size for _ in range(grid_size)]
        cell_rects = {}

        for r in range(grid_size):
            for c in range(grid_size):
                x0, y0 = c * cell_px, r * cell_px
                x1, y1 = x0 + cell_px, y0 + cell_px
                rect_id = editor_canvas.create_rectangle(x0, y0, x1, y1, fill="black", outline="#222222")
                cell_rects[(r, c)] = rect_id

        # Al hacer click se decide si esa "pasada" pinta o borra, y el arrastre respeta esa decisión
        paint_state = {"value": 1}

        def set_pixel(r, c, value):
            icon_grid[r][c] = value
            editor_canvas.itemconfig(cell_rects[(r, c)], fill="white" if value == 1 else "black")

        def cell_from_event(event):
            c = event.x // cell_px
            r = event.y // cell_px
            if 0 <= r < grid_size and 0 <= c < grid_size:
                return r, c
            return None

        def on_click(event):
            pos = cell_from_event(event)
            if pos is None:
                return
            r, c = pos
            paint_state["value"] = 0 if icon_grid[r][c] == 1 else 1
            set_pixel(r, c, paint_state["value"])

        def on_drag(event):
            pos = cell_from_event(event)
            if pos is None:
                return
            r, c = pos
            set_pixel(r, c, paint_state["value"])

        editor_canvas.bind("<Button-1>", on_click)
        editor_canvas.bind("<B1-Motion>", on_drag)

        def clear_grid():
            for r in range(grid_size):
                for c in range(grid_size):
                    set_pixel(r, c, 0)

        ctk.CTkButton(popup, text="🧹 Limpiar dibujo", width=110, height=24,
                      command=clear_grid, fg_color="#555555").pack(pady=(0, 6))

        status_lbl = ctk.CTkLabel(popup, text="", text_color="orange", font=("Arial", 10))
        status_lbl.pack(pady=(0, 4))

        def revert_dropdown():
            # Vuelve el desplegable al ícono actual de la capa, sin dejarlo trabado en el sentinel
            current_icon = self.config_data["layers"][self.active_layer_index].get("icon", "MONITOR")
            self.icon_menu.set(current_icon)

        def confirm(event=None):
            name = entry.get().strip().upper().replace(" ", "_")
            if not name:
                status_lbl.configure(text="Ingresá un nombre.")
                return
            if not name.replace("_", "").isalnum():
                status_lbl.configure(text="Solo letras, números y '_'.")
                return
            if name in AVAILABLE_ICONS:
                status_lbl.configure(text="Ese ícono ya existe.")
                return

            # Guarda el bitmap dibujado. Si quedó vacío, el preview cae al ícono genérico como respaldo.
            self.config_data.setdefault("custom_icons", {})[name] = [row[:] for row in icon_grid]

            AVAILABLE_ICONS.append(name)
            self.icon_menu.configure(values=AVAILABLE_ICONS + [NEW_ICON_SENTINEL])
            self.icon_menu.set(name)
            self.config_data["layers"][self.active_layer_index]["icon"] = name
            self.refresh_layers_list()

            popup.grab_release()
            popup.destroy()

        def cancel():
            revert_dropdown()
            popup.grab_release()
            popup.destroy()

        btn_frame = ctk.CTkFrame(popup, fg_color="transparent")
        btn_frame.pack(pady=10)
        ctk.CTkButton(btn_frame, text="✅ Agregar", command=confirm, fg_color="#1f538d").pack(side="left", padx=5)
        ctk.CTkButton(btn_frame, text="Cancelar", command=cancel, fg_color="firebrick", hover_color="darkred").pack(side="left", padx=5)

        popup.protocol("WM_DELETE_WINDOW", cancel)

    def edit_current_icon(self):
        """Abre el editor de píxeles para el ícono de la capa activa (personalizado o base)."""
        current_icon = self.config_data["layers"][self.active_layer_index].get("icon", "MONITOR")
        self.open_edit_icon_popup(current_icon)

