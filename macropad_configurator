    def add_layer(self):
        new_index = len(self.config_data["layers"])
        new_layer = {
            "name": f"CAPA_{new_index}",
            "icon": "MONITOR",
            "keys": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9"],
            "encoders": default_encoders()
        }
        self.config_data["layers"].append(new_layer)
        self.select_layer(new_index)

    def delete_layer(self):
        if len(self.config_data["layers"]) <= 1:
            self.status_lbl.configure(text="¡Debes mantener al menos 1 capa!", text_color="orange")
            return

        del self.config_data["layers"][self.active_layer_index]
        self.active_layer_index = max(0, self.active_layer_index - 1)
        self.refresh_layers_list()

    # ------------------------------------------------------------------
    # Guardar / Cargar configuración (archivo .json local)
    # ------------------------------------------------------------------
    def save_config_to_file(self):
        """Guarda toda la config_data (capas, botones, encoders, íconos custom) en un .json local."""
        path = filedialog.asksaveasfilename(
            title="Guardar configuración del Macropad",
            defaultextension=".json",
            filetypes=[("Archivo JSON", "*.json"), ("Todos los archivos", "*.*")]
        )
        if not path:
            return  # el usuario canceló el diálogo

        try:
            with open(path, "w", encoding="utf-8") as f:
                json.dump(self.config_data, f, indent=2, ensure_ascii=False)
            self.status_lbl.configure(text="💾 Configuración guardada ✅", text_color="lightgreen")
        except Exception as e:
            self.status_lbl.configure(text=f"Error al guardar: {e}", text_color="red")

    def load_config_from_file(self):
        """Carga una config_data guardada previamente y refresca toda la UI con esos datos."""
        path = filedialog.askopenfilename(
            title="Cargar configuración del Macropad",
            defaultextension=".json",
            filetypes=[("Archivo JSON", "*.json"), ("Todos los archivos", "*.*")]
        )
        if not path:
            return  # el usuario canceló el diálogo

        try:
            with open(path, "r", encoding="utf-8") as f:
                loaded = json.load(f)
        except Exception as e:
            self.status_lbl.configure(text=f"Error al leer el archivo: {e}", text_color="red")
            return

        # Validación básica de estructura
        if not isinstance(loaded, dict) or "layers" not in loaded or not isinstance(loaded["layers"], list) or len(loaded["layers"]) == 0:
            self.status_lbl.configure(text="⚠️ Archivo inválido: falta 'layers'", text_color="orange")
            return

        # Rellena campos faltantes por si el archivo viene de una versión anterior de la app
        for layer in loaded["layers"]:
            layer.setdefault("name", "CAPA")
            layer.setdefault("icon", "MONITOR")
            layer.setdefault("keys", ["F1"] * 9)
            while len(layer["keys"]) < 9:
                layer["keys"].append("F1")
            layer.setdefault("encoders", default_encoders())
            while len(layer["encoders"]) < NUM_ENCODERS:
                layer["encoders"].append({"ccw": "F1", "cw": "F1", "push": "F1"})
        loaded.setdefault("custom_icons", {})

        # Cierra cualquier popup de encoder abierto antes de reemplazar todo
        self.close_all_encoder_popups()
        self.capturing_target = None

        self.config_data = loaded
        self.active_layer_index = 0

        # Registra en el desplegable cualquier ícono (custom o no) que venga en el archivo
        icons_in_file = set(self.config_data["custom_icons"].keys())
        icons_in_file.update(layer.get("icon", "MONITOR") for layer in self.config_data["layers"])
        for icon_name in icons_in_file:
            if icon_name not in AVAILABLE_ICONS:
                AVAILABLE_ICONS.append(icon_name)
        self.icon_menu.configure(values=AVAILABLE_ICONS + [NEW_ICON_SENTINEL])

        self.refresh_layers_list()
        self.status_lbl.configure(text="📂 Configuración cargada ✅", text_color="lightgreen")

    # ------------------------------------------------------------------
    # Simulador de pantalla OLED (128x64)
    # ------------------------------------------------------------------
    def draw_oled_text(self, text, x, y, font_size=8):
        """Simula la función display.text de Adafruit SSD1306"""
        self.oled_canvas.create_text(
            x * self.oled_scale,
            y * self.oled_scale,
            text=text,
            fill="white",
            anchor="nw",
            font=("Courier New", int(font_size * self.oled_scale), "bold")
        )

    def draw_fill_rect(self, x, y, w, h, color):
        """Simula display.fill_rect(x, y, w, h, color) donde 1 es blanco y 0 es negro"""
        fill_color = "white" if color == 1 else "black"
        self.oled_canvas.create_rectangle(
            x * self.oled_scale,
            y * self.oled_scale,
            (x + w) * self.oled_scale,
            (y + h) * self.oled_scale,
            fill=fill_color,
            outline=""
        )

    def draw_fill_circle(self, cx, cy, r, color):
        """Simula un círculo relleno (para íconos redondeados: botones de gamepad, notas musicales, etc.)"""
        fill_color = "white" if color == 1 else "black"
        s = self.oled_scale
        self.oled_canvas.create_oval(
            (cx - r) * s, (cy - r) * s,
            (cx + r) * s, (cy + r) * s,
            fill=fill_color, outline=""
        )

    def refresh_oled_preview(self):
        """Vuelve a dibujar la pantalla OLED simulada según la capa activa (ícono + nombre)."""
        if not hasattr(self, "oled_canvas"):
            return

        layer = self.config_data["layers"][self.active_layer_index]
        self.oled_canvas.delete("all")

        # Título superior fijo
        self.draw_oled_text("- MACROPAD v0.9 -", 10, 2, font_size=7)

        # Dibuja el ícono correspondiente: primero un bitmap custom dibujado a mano,
        # luego el arte pixel-art propio, y como último recurso uno genérico
        icon = layer.get("icon", "MONITOR")
        if icon in self.config_data.get("custom_icons", {}):
            self.draw_custom_icon(icon)
        else:
            draw_func = getattr(self, f"draw_icon_{icon.lower()}", None)
            if callable(draw_func):
                draw_func()
            else:
                self.draw_icon_generic(icon)

        # Nombre de la capa al lado del ícono
        name = layer.get("name", "")[:10]
        self.draw_oled_text(name, 26, 18, font_size=8)

    def draw_icon_camera(self):
        """Ícono de cámara (Cuerpo + Lente) - usado por defecto en la capa STREAM"""
        self.draw_fill_rect(4, 16, 10, 8, 1)   # Cuerpo de la cámara
        self.draw_fill_rect(14, 18, 3, 4, 1)   # Lente frontal

    def draw_icon_monitor(self):
        """Ícono de monitor/pantalla con base"""
        self.draw_fill_rect(3, 15, 16, 10, 1)  # Marco externo de la pantalla
        self.draw_fill_rect(5, 17, 12, 6, 0)   # Área interior (negra)
        self.draw_fill_rect(9, 25, 4, 2, 1)    # Cuello del pie
        self.draw_fill_rect(6, 27, 10, 2, 1)   # Base

    def draw_icon_gamepad(self):
        """Ícono de gamepad (cuerpo + botones)"""
        self.draw_fill_rect(3, 18, 16, 8, 1)   # Cuerpo del control
        self.draw_fill_circle(15, 20, 2, 0)    # Botón hueco superior
        self.draw_fill_circle(18, 23, 2, 0)    # Botón hueco derecho
        self.draw_fill_rect(6, 21, 4, 1, 0)    # Cruceta horizontal
        self.draw_fill_rect(7, 20, 1, 3, 0)    # Cruceta vertical

    def draw_icon_music(self):
        """Ícono de nota musical"""
        self.draw_fill_rect(13, 14, 1, 12, 1)  # Palo de la nota
        self.draw_fill_rect(13, 14, 5, 1, 1)   # Barra superior (corchea)
        self.draw_fill_circle(10, 27, 3, 1)    # Cabeza de la nota

    def draw_icon_folder(self):
        """Ícono de carpeta"""
        self.draw_fill_rect(4, 20, 4, 2, 1)    # Pestaña
        self.draw_fill_rect(4, 22, 16, 8, 1)   # Cuerpo de la carpeta

    def draw_icon_code(self):
        """Ícono de código, dibujado como texto '</>' """
        self.draw_oled_text("</>", 3, 17, font_size=9)

    def draw_icon_generic(self, icon_name):
        """Ícono genérico de respaldo: si un ícono custom quedó sin dibujo, muestra un recuadro
        con las primeras 2 letras del nombre adentro."""
        self.draw_fill_rect(3, 15, 16, 12, 1)   # Marco externo
        self.draw_fill_rect(5, 17, 12, 8, 0)    # Interior negro
        abbrev = icon_name[:2] if len(icon_name) >= 2 else icon_name
        self.draw_oled_text(abbrev, 6, 18, font_size=6)

    def draw_custom_icon(self, name):
        """Dibuja el bitmap 16x16 que el usuario armó en el mini editor de píxeles."""
        bitmap = self.config_data.get("custom_icons", {}).get(name)
        if not bitmap or not any(any(row) for row in bitmap):
            # No dibujó nada: cae al ícono genérico con las iniciales
            self.draw_icon_generic(name)
            return
        for r, row_pixels in enumerate(bitmap):
            for c, val in enumerate(row_pixels):
                if val:
                    self.draw_fill_rect(4 + c, 14 + r, 1, 1, 1)

    def rasterize_builtin_icon(self, icon_name):
        """Convierte el dibujo por código de un ícono base (cámara, monitor, gamepad, etc.) en una
        matriz de píxeles 16x16, para usarla como punto de partida editable en el mini editor.
        Si el ícono no tiene un rasterizado conocido (ej. CODE, que es texto), devuelve una grilla vacía."""
        grid_size = 16
        grid = [[0] * grid_size for _ in range(grid_size)]

        def fill_rect(x, y, w, h, color):
            for gy in range(grid_size):
                wy = 14 + gy
                if not (y <= wy < y + h):
                    continue
                for gx in range(grid_size):
                    wx = 4 + gx
                    if x <= wx < x + w:
                        grid[gy][gx] = color

        def fill_circle(cx, cy, r, color):
            for gy in range(grid_size):
                wy = 14 + gy
                for gx in range(grid_size):
                    wx = 4 + gx
                    if (wx + 0.5 - cx) ** 2 + (wy + 0.5 - cy) ** 2 <= r * r:
                        grid[gy][gx] = color

        icon = icon_name.upper()
        if icon == "CAMERA":
            fill_rect(4, 16, 10, 8, 1)
            fill_rect(14, 18, 3, 4, 1)
        elif icon == "MONITOR":
            fill_rect(3, 15, 16, 10, 1)
            fill_rect(5, 17, 12, 6, 0)
            fill_rect(9, 25, 4, 2, 1)
            fill_rect(6, 27, 10, 2, 1)
        elif icon == "GAMEPAD":
            fill_rect(3, 18, 16, 8, 1)
            fill_circle(15, 20, 2, 0)
            fill_circle(18, 23, 2, 0)
            fill_rect(6, 21, 4, 1, 0)
            fill_rect(7, 20, 1, 3, 0)
        elif icon == "MUSIC":
            fill_rect(13, 14, 1, 12, 1)
            fill_rect(13, 14, 5, 1, 1)
            fill_circle(10, 27, 3, 1)
        elif icon == "FOLDER":
            fill_rect(4, 20, 4, 2, 1)
            fill_rect(4, 22, 16, 8, 1)
        # CODE (texto "</>"), íconos genéricos sin dibujo propio, o nombres desconocidos:
        # no hay un rasterizado confiable, así que arranca en blanco para dibujar a mano.

        return grid


    def reconnect_pico(self):
        """Cierra la conexión serial actual (si la hay) y vuelve a escanear los puertos COM desde cero.
        Corre en un hilo aparte para no congelar la UI mientras escanea/abre el puerto."""
        self.btn_reconnect.configure(state="disabled", text="🔄 Buscando...")
        self.status_lbl.configure(text="🔄 Buscando Pico...", text_color="yellow")

        def _scan():
            if self.serial_port is not None:
                try:
                    if self.serial_port.is_open:
                        self.serial_port.close()
                except Exception:
                    pass
                self.serial_port = None

            self.find_pico_port()
            self.after(0, lambda: self.btn_reconnect.configure(state="normal", text="🔄 Reconectar"))

        threading.Thread(target=_scan, daemon=True).start()

    def find_pico_port(self):
        ports = serial.tools.list_ports.comports()
        for port in ports:
            if "CircuitPython" in port.description or "Board" in port.description or "USB Serial" in port.description:
                try:
                    self.serial_port = serial.Serial(port.device, 115200, timeout=1)
                    self.after(0, lambda p=port.device: self.status_lbl.configure(text=f"Conectado: {p} ✅", text_color="lightgreen"))
                    return
                except Exception:
                    pass
        self.after(0, lambda: self.status_lbl.configure(text="Pico no encontrada ❌", text_color="red"))

    def send_to_pico(self):
        if not self.serial_port or not self.serial_port.is_open:
            self.find_pico_port()
            if not self.serial_port:
                return

        try:
            json_payload = json.dumps(self.config_data) + "\n"
            self.serial_port.write(json_payload.encode('utf-8'))
            self.status_lbl.configure(text="¡Atajos e Íconos Guardados! 🎉", text_color="cyan")
        except Exception as e:
            self.status_lbl.configure(text=f"Error al enviar datos: {e}", text_color="red")


