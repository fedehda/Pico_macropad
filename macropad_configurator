            icon_grid = [row[:] for row in existing_bitmap]
        else:
            # No hay bitmap propio todavía: si es un ícono base con arte por código, lo rasterizamos
            # como punto de partida editable; si no, arranca en blanco.
            icon_grid = self.rasterize_builtin_icon(icon_name)

        cell_rects = {}
        for r in range(grid_size):
            for c in range(grid_size):
                x0, y0 = c * cell_px, r * cell_px
                x1, y1 = x0 + cell_px, y0 + cell_px
                initial_color = "white" if icon_grid[r][c] == 1 else "black"
                rect_id = editor_canvas.create_rectangle(x0, y0, x1, y1, fill=initial_color, outline="#222222")
                cell_rects[(r, c)] = rect_id

        paint_state = {"value": 1}

        def set_pixel(r, c, value):
            icon_grid[r][c] = value
            editor_canvas.itemconfig(cell_rects[(r, c)], fill="white" if value == 1 else "black")

        def cell_from_event(event):
            c = event.x // cell_px
            r = event.y // cell_px
            if 0 <= r < grid_size and 0 <= c < grid_size:
                return r, c
            return None

        def on_click(event):
            pos = cell_from_event(event)
            if pos is None:
                return
            r, c = pos
            paint_state["value"] = 0 if icon_grid[r][c] == 1 else 1
            set_pixel(r, c, paint_state["value"])

        def on_drag(event):
            pos = cell_from_event(event)
            if pos is None:
                return
            r, c = pos
            set_pixel(r, c, paint_state["value"])

        editor_canvas.bind("<Button-1>", on_click)
        editor_canvas.bind("<B1-Motion>", on_drag)

        def clear_grid():
            for r in range(grid_size):
                for c in range(grid_size):
                    set_pixel(r, c, 0)

        ctk.CTkButton(popup, text="🧹 Limpiar dibujo", width=110, height=24,
                      command=clear_grid, fg_color="#555555").pack(pady=(0, 10))

        def save_changes():
            self.config_data["custom_icons"][icon_name] = [row[:] for row in icon_grid]
            # Si la capa activa usa este ícono, refresca la vista previa OLED al toque
            active_layer = self.config_data["layers"][self.active_layer_index]
            if active_layer.get("icon") == icon_name:
                self.refresh_oled_preview()
            self.refresh_layers_list()  # refresca por si otra capa en la lista lo usa como ícono visible
            popup.grab_release()
            popup.destroy()

        def cancel():
            popup.grab_release()
            popup.destroy()

        btn_frame = ctk.CTkFrame(popup, fg_color="transparent")
        btn_frame.pack(pady=10)
        ctk.CTkButton(btn_frame, text="💾 Guardar Cambios", command=save_changes, fg_color="#1f538d").pack(side="left", padx=5)
